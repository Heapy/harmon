-- reported distinguishes full alerts from capped keys with no text; severity is stored by stable name.
CREATE TABLE alert (
  sample_id INTEGER NOT NULL REFERENCES sample(id) ON DELETE CASCADE,
  key       TEXT NOT NULL,
  reported  INTEGER NOT NULL,
  severity  TEXT,
  title     TEXT,
  message   TEXT
);

-- Per-channel outcomes preserve failures and details that the report itself does not carry.
CREATE TABLE alert_delivery (
  sample_id  INTEGER NOT NULL REFERENCES sample(id) ON DELETE CASCADE,
  channel    TEXT NOT NULL,
  successful INTEGER NOT NULL,
  detail     TEXT NOT NULL
);

-- Both indexes serve per-sample reads and retention cascades.
CREATE INDEX alert_sample_id ON alert(sample_id);

CREATE INDEX alert_delivery_sample_id ON alert_delivery(sample_id);

-- Agent state is not retained sample history. Only firing keys appear; retry_at_sample uses the
-- absolute counter in agent_state.
CREATE TABLE alert_state (
  key             TEXT NOT NULL PRIMARY KEY,
  settled         INTEGER NOT NULL,
  failures        INTEGER NOT NULL,
  retry_at_sample INTEGER NOT NULL
);

insertAlert:
INSERT INTO alert(sample_id, key, reported, severity, title, message)
VALUES (?, ?, ?, ?, ?, ?);

selectAlerts:
SELECT *
FROM alert
WHERE sample_id = ?
ORDER BY key;

insertAlertDelivery:
INSERT INTO alert_delivery(sample_id, channel, successful, detail)
VALUES (?, ?, ?, ?);

selectAlertDeliveries:
SELECT *
FROM alert_delivery
WHERE sample_id = ?
ORDER BY channel;

-- Replacing the snapshot makes cleared keys disappear atomically with the sample transaction.
deleteAlertState:
DELETE FROM alert_state;

insertAlertState:
INSERT INTO alert_state(key, settled, failures, retry_at_sample)
VALUES (?, ?, ?, ?);

selectAlertState:
SELECT *
FROM alert_state
ORDER BY key;
