-- Identity is pid plus start time. First-seen metadata is frozen except a null executable path may
-- be filled later. reparented_at is a timestamp so it survives deletion of the triggering sample.
CREATE TABLE process (
  id              INTEGER PRIMARY KEY AUTOINCREMENT,
  pid             INTEGER NOT NULL,
  started_at      INTEGER NOT NULL,
  name            TEXT NOT NULL,
  executable_path TEXT,
  uid             INTEGER,
  parent_pid      INTEGER NOT NULL,
  reparented_at   TEXT,
  UNIQUE (pid, started_at)
);

-- Unbundled singleton groups have a null application_id. process_id and application_id omit foreign
-- keys deliberately: explicit orphan cleanup avoids a full child-table scan per deleted parent.
CREATE TABLE process_sample (
  sample_id                             INTEGER NOT NULL REFERENCES sample(id) ON DELETE CASCADE,
  process_id                            INTEGER NOT NULL,
  application_id                        INTEGER,

  cpu_percent                           REAL NOT NULL,
  user_cpu_percent                      REAL NOT NULL,
  system_cpu_percent                    REAL NOT NULL,

  physical_footprint_bytes              INTEGER NOT NULL,
  resident_bytes                        INTEGER NOT NULL,
  wired_bytes                           INTEGER NOT NULL,
  lifetime_max_physical_footprint_bytes INTEGER NOT NULL,
  -- Null means attribution was unavailable; zero is a measured reading.
  compressed_or_paged_out_bytes         INTEGER,
  virtual_memory_region_count           INTEGER,

  wakeups_per_second                    REAL NOT NULL,
  page_ins_per_second                   REAL NOT NULL,
  disk_read_bytes_per_second            REAL NOT NULL,
  disk_write_bytes_per_second           REAL NOT NULL,
  logical_write_bytes_per_second        REAL NOT NULL,
  instructions_per_second               REAL NOT NULL,
  cycles_per_second                     REAL NOT NULL,
  energy_watts                          REAL NOT NULL,
  faults_per_second                     REAL NOT NULL,
  copy_on_write_faults_per_second       REAL NOT NULL,
  system_calls_per_second               REAL NOT NULL,
  context_switches_per_second           REAL NOT NULL,
  thread_count                          INTEGER NOT NULL,
  running_thread_count                  INTEGER NOT NULL,
  billed_energy_per_second              REAL NOT NULL,
  battery_impact_score                  REAL NOT NULL
);

-- Supports sample reads and cascades. process_id stays unindexed for lower write amplification.
CREATE INDEX process_sample_sample_id ON process_sample(sample_id);

insertProcess:
INSERT INTO process(pid, started_at, name, executable_path, uid, parent_pid)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT (pid, started_at) DO UPDATE SET executable_path = excluded.executable_path
WHERE process.executable_path IS NULL AND excluded.executable_path IS NOT NULL;

-- Separate from the frequent upsert and idempotent so later observations cannot move the event.
markReparented:
UPDATE process
SET reparented_at = ?
WHERE id = ? AND reparented_at IS NULL;

-- ON CONFLICT may write nothing, so last_insert_rowid() could name an unrelated prior insert.
selectProcessId:
SELECT id
FROM process
WHERE pid = ? AND started_at = ?;

selectProcesses:
SELECT *
FROM process
ORDER BY id;

insertProcessSample:
INSERT INTO process_sample(
  sample_id, process_id, application_id,
  cpu_percent, user_cpu_percent, system_cpu_percent,
  physical_footprint_bytes, resident_bytes, wired_bytes,
  lifetime_max_physical_footprint_bytes, compressed_or_paged_out_bytes,
  virtual_memory_region_count,
  wakeups_per_second, page_ins_per_second,
  disk_read_bytes_per_second, disk_write_bytes_per_second, logical_write_bytes_per_second,
  instructions_per_second, cycles_per_second, energy_watts,
  faults_per_second, copy_on_write_faults_per_second,
  system_calls_per_second, context_switches_per_second,
  thread_count, running_thread_count,
  billed_energy_per_second, battery_impact_score
)
VALUES (
  ?, ?, ?,
  ?, ?, ?,
  ?, ?, ?,
  ?, ?,
  ?,
  ?, ?,
  ?, ?, ?,
  ?, ?, ?,
  ?, ?,
  ?, ?,
  ?, ?,
  ?, ?
);

selectProcessSamples:
SELECT *
FROM process_sample
WHERE sample_id = ?
ORDER BY process_id;

-- NOT IN scans the deliberately unindexed child column once instead of once per lookup row.
deleteOrphanProcesses:
DELETE FROM process
WHERE id NOT IN (SELECT process_id FROM process_sample);
