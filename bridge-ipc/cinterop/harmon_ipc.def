package = dev.yoda.harmon.nativebridge.ipc
headerFilter = harmon_ipc.h

---
#ifndef HARMON_IPC_H
#define HARMON_IPC_H

#include <arpa/inet.h>
#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/stat.h>
#include <sys/time.h>
#include <sys/un.h>
#include <time.h>
#include <unistd.h>

#ifdef __cplusplus
extern "C" {
#endif

#define HM_MAX_JSON_FRAME_SIZE (32U * 1024U * 1024U)

static inline void hm_sleep_millis(uint64_t milliseconds) {
    struct timespec requested = {
        .tv_sec = (time_t)(milliseconds / 1000ULL),
        .tv_nsec = (long)((milliseconds % 1000ULL) * 1000000ULL),
    };
    struct timespec remaining;
    while (nanosleep(&requested, &remaining) != 0 && errno == EINTR) {
        requested = remaining;
    }
}

static inline int hm_set_socket_options(int descriptor) {
    int enabled = 1;
    if (setsockopt(
            descriptor,
            SOL_SOCKET,
            SO_NOSIGPIPE,
            &enabled,
            (socklen_t)sizeof(enabled)
        ) != 0) {
        return -1;
    }

    struct timeval timeout = {
        .tv_sec = 30,
        .tv_usec = 0,
    };
    if (setsockopt(
            descriptor,
            SOL_SOCKET,
            SO_SNDTIMEO,
            &timeout,
            (socklen_t)sizeof(timeout)
        ) != 0 ||
        setsockopt(
            descriptor,
            SOL_SOCKET,
            SO_RCVTIMEO,
            &timeout,
            (socklen_t)sizeof(timeout)
        ) != 0) {
        return -1;
    }

    int flags = fcntl(descriptor, F_GETFD);
    if (flags < 0 || fcntl(descriptor, F_SETFD, flags | FD_CLOEXEC) != 0) {
        return -1;
    }
    return 0;
}

static inline int hm_unix_server_open(const char *path, uint32_t group_id) {
    if (path == NULL || path[0] == '\0') {
        errno = EINVAL;
        return -1;
    }
    if (strlen(path) >= sizeof(((struct sockaddr_un *)0)->sun_path)) {
        errno = ENAMETOOLONG;
        return -1;
    }

    struct stat existing;
    if (lstat(path, &existing) == 0) {
        if (!S_ISSOCK(existing.st_mode) || existing.st_uid != geteuid()) {
            errno = EEXIST;
            return -1;
        }
        if (unlink(path) != 0) {
            return -1;
        }
    } else if (errno != ENOENT) {
        return -1;
    }

    int descriptor = socket(AF_UNIX, SOCK_STREAM, 0);
    if (descriptor < 0) {
        return -1;
    }
    if (hm_set_socket_options(descriptor) != 0) {
        int saved_errno = errno;
        close(descriptor);
        errno = saved_errno;
        return -1;
    }

    struct sockaddr_un address;
    memset(&address, 0, sizeof(address));
    address.sun_family = AF_UNIX;
    snprintf(address.sun_path, sizeof(address.sun_path), "%s", path);

    if (bind(descriptor, (struct sockaddr *)&address, (socklen_t)sizeof(address)) != 0) {
        int saved_errno = errno;
        close(descriptor);
        errno = saved_errno;
        return -1;
    }
    if (chmod(path, 0660) != 0) {
        int saved_errno = errno;
        close(descriptor);
        unlink(path);
        errno = saved_errno;
        return -1;
    }
    if (geteuid() == 0 && chown(path, 0, (gid_t)group_id) != 0) {
        int saved_errno = errno;
        close(descriptor);
        unlink(path);
        errno = saved_errno;
        return -1;
    }
    if (listen(descriptor, 8) != 0) {
        int saved_errno = errno;
        close(descriptor);
        unlink(path);
        errno = saved_errno;
        return -1;
    }
    return descriptor;
}

static inline int hm_unix_accept(
    int server_descriptor,
    uint32_t allowed_user_id,
    uint32_t *peer_user_id
) {
    int descriptor;
    do {
        descriptor = accept(server_descriptor, NULL, NULL);
    } while (descriptor < 0 && errno == EINTR);
    if (descriptor < 0) {
        return -1;
    }
    if (hm_set_socket_options(descriptor) != 0) {
        int saved_errno = errno;
        close(descriptor);
        errno = saved_errno;
        return -1;
    }

    uid_t user_id = UINT32_MAX;
    gid_t group_id = UINT32_MAX;
    if (getpeereid(descriptor, &user_id, &group_id) != 0) {
        int saved_errno = errno;
        close(descriptor);
        errno = saved_errno;
        return -1;
    }
    (void)group_id;
    if (peer_user_id != NULL) {
        *peer_user_id = (uint32_t)user_id;
    }
    if ((uint32_t)user_id != allowed_user_id && user_id != 0) {
        close(descriptor);
        errno = EACCES;
        return -2;
    }
    return descriptor;
}

static inline int hm_unix_connect(const char *path) {
    if (path == NULL || path[0] == '\0') {
        errno = EINVAL;
        return -1;
    }
    if (strlen(path) >= sizeof(((struct sockaddr_un *)0)->sun_path)) {
        errno = ENAMETOOLONG;
        return -1;
    }

    int descriptor = socket(AF_UNIX, SOCK_STREAM, 0);
    if (descriptor < 0) {
        return -1;
    }
    if (hm_set_socket_options(descriptor) != 0) {
        int saved_errno = errno;
        close(descriptor);
        errno = saved_errno;
        return -1;
    }

    struct sockaddr_un address;
    memset(&address, 0, sizeof(address));
    address.sun_family = AF_UNIX;
    snprintf(address.sun_path, sizeof(address.sun_path), "%s", path);
    if (connect(descriptor, (struct sockaddr *)&address, (socklen_t)sizeof(address)) != 0) {
        int saved_errno = errno;
        close(descriptor);
        errno = saved_errno;
        return -1;
    }

    uid_t peer_user_id = UINT32_MAX;
    gid_t peer_group_id = UINT32_MAX;
    if (getpeereid(descriptor, &peer_user_id, &peer_group_id) != 0) {
        int saved_errno = errno;
        close(descriptor);
        errno = saved_errno;
        return -1;
    }
    (void)peer_group_id;
    if (peer_user_id != 0 && peer_user_id != geteuid()) {
        close(descriptor);
        errno = EACCES;
        return -1;
    }
    return descriptor;
}

static inline int hm_send_all(int descriptor, const void *buffer, size_t size) {
    const uint8_t *cursor = (const uint8_t *)buffer;
    size_t remaining = size;
    while (remaining > 0) {
        ssize_t written = send(descriptor, cursor, remaining, 0);
        if (written < 0 && errno == EINTR) {
            continue;
        }
        if (written <= 0) {
            if (written == 0) {
                errno = EPIPE;
            }
            return -1;
        }
        cursor += (size_t)written;
        remaining -= (size_t)written;
    }
    return 0;
}

static inline int hm_receive_all(int descriptor, void *buffer, size_t size) {
    uint8_t *cursor = (uint8_t *)buffer;
    size_t remaining = size;
    while (remaining > 0) {
        ssize_t received = recv(descriptor, cursor, remaining, 0);
        if (received < 0 && errno == EINTR) {
            continue;
        }
        if (received <= 0) {
            if (received == 0) {
                errno = ECONNRESET;
            }
            return -1;
        }
        cursor += (size_t)received;
        remaining -= (size_t)received;
    }
    return 0;
}

static inline int hm_send_json_frame(int descriptor, const char *json) {
    if (json == NULL) {
        errno = EINVAL;
        return -1;
    }
    size_t length = strlen(json);
    if (length == 0 || length > HM_MAX_JSON_FRAME_SIZE || length > UINT32_MAX) {
        errno = EMSGSIZE;
        return -1;
    }
    uint32_t network_length = htonl((uint32_t)length);
    if (hm_send_all(descriptor, &network_length, sizeof(network_length)) != 0) {
        return -1;
    }
    return hm_send_all(descriptor, json, length);
}

static inline char *hm_receive_json_frame(
    int descriptor,
    uint32_t maximum_size,
    uint32_t *output_size
) {
    uint32_t network_length = 0;
    if (hm_receive_all(descriptor, &network_length, sizeof(network_length)) != 0) {
        return NULL;
    }
    uint32_t length = ntohl(network_length);
    if (length == 0 ||
        length > HM_MAX_JSON_FRAME_SIZE ||
        length > maximum_size) {
        errno = EMSGSIZE;
        return NULL;
    }

    char *json = (char *)malloc((size_t)length + 1U);
    if (json == NULL) {
        errno = ENOMEM;
        return NULL;
    }
    if (hm_receive_all(descriptor, json, length) != 0) {
        int saved_errno = errno;
        free(json);
        errno = saved_errno;
        return NULL;
    }
    if (memchr(json, '\0', length) != NULL) {
        free(json);
        errno = EILSEQ;
        return NULL;
    }
    json[length] = '\0';
    if (output_size != NULL) {
        *output_size = length;
    }
    return json;
}

static inline void hm_close_descriptor(int descriptor) {
    if (descriptor >= 0) {
        close(descriptor);
    }
}

static inline int hm_remove_socket(const char *path) {
    if (path == NULL || path[0] == '\0') {
        errno = EINVAL;
        return -1;
    }
    return unlink(path);
}

static inline void hm_free(void *value) {
    free(value);
}

#ifdef __cplusplus
}
#endif

#endif
