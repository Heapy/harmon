collectorSocket=/var/run/harmon.collector.sock
intervalSeconds=300
onceSampleSeconds=2
topProcessCount=8
maxAlertsPerCategory=3

# The loopback-only process tree is sampled on demand while a Live tab is visible.
# webSampleSeconds sets that visible-tab sampling period.
webUiEnabled=true
webSampleSeconds=1

# Days kept in ~/Library/Application Support/Harmon/history.db. Zero disables history.
# Accepted range: 0 to 3650.
historyRetentionDays=7

# Bundle names, without `.app`, whose descendants outside the bundle are not
# charged to it. Replaces the built-in list; an empty value disables the rule.
terminalApplications=terminal,iterm2,iterm,alacritty,wezterm,kitty,ghostty,warp,hyper,tabby,agterm

# Alert when a live process loses its parent and is handed to launchd.
orphanAlerts=true

# A zero disables the corresponding alert.
applicationCpuAlertPercent=150
applicationMemoryAlertMiB=2048
applicationDiskWriteAlertMiBPerSecond=50
swapAlertMiB=1024
swapOutAlertMiBPerSecond=25
applicationBatteryImpactAlertScore=100
applicationPowerAlertWatts=1.5
batteryLowAlertPercent=20

# Battery drain uses watts when the kernel energy counter reports and the score otherwise.
# The thresholds do not fall back to each other; zero disables only that regime.

systemNotifications=true
notifyEverySample=false
httpTimeoutSeconds=15

# Generic JSON webhook. HTTPS is required, except for local 127.0.0.1 testing.
webhookUrl=
webhookBearerToken=

# Both Telegram values are required when Telegram delivery is enabled.
telegramBotToken=
telegramChatId=
