package = io.heapy.harmon.nativebridge.probe
headerFilter = harmon_probe.h
linkerOpts = -framework IOKit -framework CoreFoundation

---
#ifndef HARMON_PROBE_H
#define HARMON_PROBE_H

#include <CoreFoundation/CoreFoundation.h>
#include <IOKit/IOKitLib.h>
#include <IOKit/ps/IOPowerSources.h>
#include <IOKit/ps/IOPSKeys.h>
#include <IOKit/storage/IOBlockStorageDriver.h>
#include <IOKit/storage/IOMedia.h>
#include <errno.h>
#include <libproc.h>
#include <mach/host_info.h>
#include <mach/mach.h>
#include <mach/mach_host.h>
#include <mach/mach_time.h>
#include <mach/vm_statistics.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mount.h>
#include <sys/sysctl.h>
#include <time.h>
#include <unistd.h>

#ifdef __cplusplus
extern "C" {
#endif

#define HM_PROCESS_NAME_SIZE 128
#define HM_PROCESS_PATH_SIZE PROC_PIDPATHINFO_SIZE
#define HM_PROCESS_ISSUE_RUSAGE 1
#define HM_PROCESS_ISSUE_CAPACITY 2
#define HM_ATTRIBUTION_REGION_LIMIT 8192
#define HM_ATTRIBUTION_MIN_REGION_SHARE 64
#define HM_ATTRIBUTION_TAIL_REGION_SHARE 128
#define HM_ATTRIBUTION_TAIL_BUDGET_DIVISOR 4
/* PID staging is never narrower than caller output; the hard cap keeps proc_listallpids' int size safe. */
#define HM_PROCESS_LIST_HEADROOM 256
#define HM_MIN_PROCESS_LIST 512
#define HM_MAX_PROCESS_LIST (1 << 20)
/* Bounds the saved-argument fallback allocation if a future kernel raises kern.argmax. */
#define HM_MAX_PROCESS_ARGS (4U * 1024U * 1024U)

typedef struct {
    int32_t pid;
    int32_t parent_pid;
    uint32_t uid;
    uint64_t started_at;
    uint64_t user_time_ns;
    uint64_t system_time_ns;
    uint64_t package_idle_wakeups;
    uint64_t interrupt_wakeups;
    uint64_t pageins;
    uint64_t disk_bytes_read;
    uint64_t disk_bytes_written;
    uint64_t logical_writes_bytes;
    uint64_t instructions;
    uint64_t cycles;
    uint64_t energy_nanojoules;
    uint64_t wired_bytes;
    uint64_t resident_bytes;
    uint64_t physical_footprint_bytes;
    uint64_t lifetime_max_physical_footprint_bytes;
    uint64_t compressed_or_paged_out_bytes;
    uint64_t faults;
    uint64_t copy_on_write_faults;
    uint64_t mach_system_calls;
    uint64_t unix_system_calls;
    uint64_t context_switches;
    uint64_t billed_energy;
    int32_t thread_count;
    int32_t running_thread_count;
    int32_t virtual_memory_region_count;
    int32_t compressed_attribution_attempted;
    int32_t compressed_attribution_available;
    char name[HM_PROCESS_NAME_SIZE];
    char executable_path[HM_PROCESS_PATH_SIZE];
} HMProcessSample;

typedef struct {
    int32_t pid;
    int32_t parent_pid;
    uint32_t uid;
    int32_t reason;
    int32_t error_code;
    char name[HM_PROCESS_NAME_SIZE];
    char executable_path[HM_PROCESS_PATH_SIZE];
} HMProcessIssue;

/* Let selftest compare cinterop's struct model with independent C-compiled sizes. */
static inline size_t hm_process_sample_size(void) {
    return sizeof(HMProcessSample);
}

static inline size_t hm_process_issue_size(void) {
    return sizeof(HMProcessIssue);
}

typedef struct {
    uint64_t total_bytes;
    uint64_t available_bytes;
    uint64_t used_bytes;
    int32_t encrypted;
} HMSwapSample;

typedef struct {
    int32_t available;
    int32_t on_battery;
    int32_t charging;
    int32_t percentage;
    int32_t minutes_remaining;
} HMBatterySample;

typedef struct {
    uint64_t user_ticks;
    uint64_t system_ticks;
    uint64_t idle_ticks;
    uint64_t nice_ticks;
} HMProcessorSample;

typedef struct {
    double one_minute;
    double five_minutes;
    double fifteen_minutes;
} HMLoadAverageSample;

typedef struct {
    uint64_t page_size_bytes;
    uint64_t free_bytes;
    uint64_t active_bytes;
    uint64_t inactive_bytes;
    uint64_t wired_bytes;
    uint64_t purgeable_bytes;
    uint64_t compressed_bytes;
    uint64_t uncompressed_bytes_in_compressor;
    uint64_t swap_backed_uncompressed_bytes;
    uint64_t pageins;
    uint64_t pageouts;
    uint64_t faults;
    uint64_t copy_on_write_faults;
    uint64_t compressions;
    uint64_t decompressions;
    uint64_t swapins;
    uint64_t swapouts;
} HMVirtualMemorySample;

typedef struct {
    int32_t available;
    int32_t device_count;
    uint64_t bytes_read;
    uint64_t bytes_written;
    uint64_t read_operations;
    uint64_t write_operations;
    uint64_t read_time_ns;
    uint64_t write_time_ns;
    uint64_t root_filesystem_total_bytes;
    uint64_t root_filesystem_available_bytes;
} HMStorageSample;

static inline uint64_t hm_monotonic_time_ns(void) {
    struct timespec value;
    if (clock_gettime(CLOCK_MONOTONIC, &value) != 0) {
        return 0;
    }
    return ((uint64_t)value.tv_sec * 1000000000ULL) + (uint64_t)value.tv_nsec;
}

static inline void hm_free(void *value) {
    free(value);
}

static inline uint64_t hm_uint32_counter(int32_t value) {
    return (uint64_t)(uint32_t)value;
}

static inline uint64_t hm_saturating_add_u64(uint64_t left, uint64_t right) {
    return UINT64_MAX - left < right ? UINT64_MAX : left + right;
}

static inline uint64_t hm_saturating_multiply_u64(uint64_t left, uint64_t right) {
    if (left == 0 || right == 0) {
        return 0;
    }
    return UINT64_MAX / left < right ? UINT64_MAX : left * right;
}

/* proc_pid_rusage CPU counters are Mach ticks; treating them as ns is wrong on Apple Silicon. */
static inline uint64_t hm_mach_time_to_ns(uint64_t ticks) {
    static mach_timebase_info_data_t timebase = {0, 0};
    if (timebase.denom == 0) {
        if (mach_timebase_info(&timebase) != KERN_SUCCESS || timebase.denom == 0) {
            timebase.numer = 1;
            timebase.denom = 1;
        }
    }
    if (timebase.numer == timebase.denom) {
        return ticks;
    }
    return hm_saturating_multiply_u64(ticks, (uint64_t)timebase.numer) /
        (uint64_t)timebase.denom;
}

static inline int hm_count_processes(void) {
    return proc_listallpids(NULL, 0);
}

/*
 * Returns 0 only for a complete region walk, 1 for a truncated undercount, and -1 when unreadable.
 * EINVAL after at least one region means end-of-space; ESRCH and every other error stay incomplete.
 * consumed_regions lets the caller enforce a sample-wide syscall budget.
 */
static inline int hm_read_compressed_or_paged_out(
    pid_t pid,
    int region_limit,
    uint64_t *output_bytes,
    int32_t *output_regions,
    int *consumed_regions
) {
    if (output_bytes == NULL ||
        output_regions == NULL ||
        consumed_regions == NULL ||
        region_limit <= 0) {
        errno = EINVAL;
        return -1;
    }
    *consumed_regions = 0;

    uint64_t address = 0;
    uint64_t pages = 0;
    int32_t regions = 0;
    int complete = 0;
    while (regions < region_limit) {
        struct proc_regioninfo region;
        memset(&region, 0, sizeof(region));
        errno = 0;
        int result = proc_pidinfo(
            pid,
            PROC_PIDREGIONINFO,
            address,
            &region,
            (int)sizeof(region)
        );
        ++(*consumed_regions);
        if (result != (int)sizeof(region)) {
            if (regions == 0) {
                return -1;
            }
            if (errno == EINVAL) {
                complete = 1;
            }
            break;
        }

        pages = hm_saturating_add_u64(
            pages,
            (uint64_t)region.pri_pages_swapped_out
        );
        ++regions;

        uint64_t next_address = region.pri_address + region.pri_size;
        if (next_address <= address || next_address < region.pri_address) {
            complete = 1;
            break;
        }
        address = next_address;
    }

    *output_bytes = hm_saturating_multiply_u64(
        pages,
        (uint64_t)getpagesize()
    );
    *output_regions = regions;
    return complete ? 0 : 1;
}

typedef struct {
    int32_t index;
    uint64_t physical_footprint_bytes;
} HMProcessAttributionCandidate;

static inline int hm_compare_process_candidates(const void *left, const void *right) {
    const HMProcessAttributionCandidate *left_candidate =
        (const HMProcessAttributionCandidate *)left;
    const HMProcessAttributionCandidate *right_candidate =
        (const HMProcessAttributionCandidate *)right;
    if (left_candidate->physical_footprint_bytes <
        right_candidate->physical_footprint_bytes) {
        return 1;
    }
    if (left_candidate->physical_footprint_bytes >
        right_candidate->physical_footprint_bytes) {
        return -1;
    }
    return left_candidate->index - right_candidate->index;
}

static inline int hm_attribute_candidate(
    HMProcessSample *sample,
    int region_limit
) {
    sample->compressed_attribution_attempted = 1;
    int consumed = 0;
    int status = hm_read_compressed_or_paged_out(
        sample->pid,
        region_limit,
        &sample->compressed_or_paged_out_bytes,
        &sample->virtual_memory_region_count,
        &consumed
    );
    if (status == 0) {
        sample->compressed_attribution_available = 1;
    }
    return consumed;
}

/*
 * Recovers paths after proc_pidpath loses an unlinked executable. KERN_PROCARGS2 must be read in
 * full because a short buffer returns its tail, and only absolute, untruncated paths are accepted
 * so unrelated relative executable names cannot collapse into one group.
 */
static inline int hm_read_exec_path_from_args(pid_t pid, char *out, uint32_t out_size) {
    int name[3] = {CTL_KERN, KERN_PROCARGS2, (int)pid};
    size_t region_size = 0;
    if (sysctl(name, 3, NULL, &region_size, NULL, 0) != 0 ||
        region_size <= sizeof(int) ||
        region_size > HM_MAX_PROCESS_ARGS) {
        return 0;
    }

    char *region = (char *)malloc(region_size);
    if (region == NULL) {
        return 0;
    }

    int written = 0;
    if (sysctl(name, 3, region, &region_size, NULL, 0) == 0 && region_size > sizeof(int)) {
        const char *path = region + sizeof(int);
        const size_t readable = region_size - sizeof(int);
        if (memchr(path, '\0', readable) != NULL && path[0] == '/') {
            const int length = snprintf(out, out_size, "%s", path);
            if (length > 0 && (uint32_t)length < out_size) {
                written = 1;
            } else {
                out[0] = '\0';
            }
        }
    }
    free(region);
    return written;
}

static inline void hm_read_process_metadata(
    pid_t pid,
    int32_t *parent_pid,
    uint32_t *uid,
    char *name,
    uint32_t name_size,
    char *executable_path,
    uint32_t executable_path_size
) {
    if (parent_pid != NULL) {
        *parent_pid = 0;
    }
    if (uid != NULL) {
        *uid = UINT32_MAX;
    }
    if (name != NULL && name_size > 0) {
        name[0] = '\0';
    }
    if (executable_path != NULL && executable_path_size > 0) {
        executable_path[0] = '\0';
    }

    struct proc_bsdinfo process_info;
    memset(&process_info, 0, sizeof(process_info));
    int info_size = proc_pidinfo(
        pid,
        PROC_PIDTBSDINFO,
        0,
        &process_info,
        (int)sizeof(process_info)
    );
    if (info_size == (int)sizeof(process_info)) {
        if (parent_pid != NULL) {
            *parent_pid = (int32_t)process_info.pbi_ppid;
        }
        if (uid != NULL) {
            *uid = process_info.pbi_uid;
        }
    }

    if (name != NULL && name_size > 0) {
        int name_result = proc_name(pid, name, name_size);
        if (name_result <= 0 && info_size == (int)sizeof(process_info)) {
            const char *fallback = process_info.pbi_name[0] != '\0'
                ? process_info.pbi_name
                : process_info.pbi_comm;
            snprintf(name, name_size, "%s", fallback);
        }
        name[name_size - 1] = '\0';
    }

    if (executable_path != NULL && executable_path_size > 0) {
        if (proc_pidpath(pid, executable_path, executable_path_size) <= 0 &&
            !hm_read_exec_path_from_args(pid, executable_path, executable_path_size)) {
            executable_path[0] = '\0';
        }
        executable_path[executable_path_size - 1] = '\0';
    }
}

/* Takes the larger fresh count and caller capacity so the staging list cannot silently drop entries. */
static inline int hm_process_list_capacity(int counted, int output_capacity) {
    int capacity = counted > output_capacity ? counted : output_capacity;
    capacity = capacity > HM_MAX_PROCESS_LIST - HM_PROCESS_LIST_HEADROOM
        ? HM_MAX_PROCESS_LIST
        : capacity + HM_PROCESS_LIST_HEADROOM;
    return capacity < HM_MIN_PROCESS_LIST ? HM_MIN_PROCESS_LIST : capacity;
}

static inline int hm_list_processes(
    HMProcessSample *output,
    int output_capacity,
    HMProcessIssue *issues,
    int issue_capacity,
    int attribution_process_limit,
    int attribution_region_budget,
    int *total_processes,
    int *inaccessible_processes,
    int *written_issues
) {
    if (output == NULL ||
        output_capacity <= 0 ||
        issues == NULL ||
        issue_capacity <= 0 ||
        attribution_process_limit < 0 ||
        attribution_region_budget < 0) {
        errno = EINVAL;
        return -1;
    }

    /* Count immediately before listing to minimize the process-start race. */
    int capacity = hm_process_list_capacity(proc_listallpids(NULL, 0), output_capacity);

    pid_t *pids = (pid_t *)calloc((size_t)capacity, sizeof(pid_t));
    if (pids == NULL) {
        errno = ENOMEM;
        return -1;
    }

    int listed = proc_listallpids(pids, capacity * (int)sizeof(pid_t));
    if (listed < 0) {
        int saved_errno = errno;
        free(pids);
        errno = saved_errno;
        return -1;
    }

    if (total_processes != NULL) {
        *total_processes = listed;
    }

    int inaccessible = 0;
    int issue_count = 0;
    int written = 0;
    for (int index = 0; index < listed; ++index) {
        const pid_t pid = pids[index];
        if (pid < 0) {
            continue;
        }

        if (written >= output_capacity) {
            ++inaccessible;
            if (issue_count < issue_capacity) {
                HMProcessIssue *issue = &issues[issue_count++];
                memset(issue, 0, sizeof(*issue));
                issue->pid = pid;
                issue->uid = UINT32_MAX;
                issue->reason = HM_PROCESS_ISSUE_CAPACITY;
                hm_read_process_metadata(
                    pid,
                    &issue->parent_pid,
                    &issue->uid,
                    issue->name,
                    (uint32_t)sizeof(issue->name),
                    issue->executable_path,
                    (uint32_t)sizeof(issue->executable_path)
                );
            }
            continue;
        }

        struct rusage_info_v6 usage;
        memset(&usage, 0, sizeof(usage));
        int usage_result = proc_pid_rusage(
            pid,
            RUSAGE_INFO_V6,
            (rusage_info_t *)&usage
        );
        if (usage_result != 0 && errno == EINVAL) {
            usage_result = proc_pid_rusage(
                pid,
                RUSAGE_INFO_V4,
                (rusage_info_t *)&usage
            );
        }
        if (usage_result != 0) {
            int usage_errno = errno;
            ++inaccessible;
            if (issue_count < issue_capacity) {
                HMProcessIssue *issue = &issues[issue_count++];
                memset(issue, 0, sizeof(*issue));
                issue->pid = pid;
                issue->reason = HM_PROCESS_ISSUE_RUSAGE;
                issue->error_code = usage_errno;
                hm_read_process_metadata(
                    pid,
                    &issue->parent_pid,
                    &issue->uid,
                    issue->name,
                    (uint32_t)sizeof(issue->name),
                    issue->executable_path,
                    (uint32_t)sizeof(issue->executable_path)
                );
            }
            continue;
        }

        HMProcessSample *sample = &output[written];
        memset(sample, 0, sizeof(*sample));
        sample->pid = pid;
        sample->started_at = usage.ri_proc_start_abstime;
        sample->user_time_ns = hm_mach_time_to_ns(usage.ri_user_time);
        sample->system_time_ns = hm_mach_time_to_ns(usage.ri_system_time);
        sample->package_idle_wakeups = usage.ri_pkg_idle_wkups;
        sample->interrupt_wakeups = usage.ri_interrupt_wkups;
        sample->pageins = usage.ri_pageins;
        sample->disk_bytes_read = usage.ri_diskio_bytesread;
        sample->disk_bytes_written = usage.ri_diskio_byteswritten;
        sample->logical_writes_bytes = usage.ri_logical_writes;
        sample->instructions = usage.ri_instructions;
        sample->cycles = usage.ri_cycles;
        sample->energy_nanojoules = usage.ri_energy_nj;
        sample->wired_bytes = usage.ri_wired_size;
        sample->resident_bytes = usage.ri_resident_size;
        sample->physical_footprint_bytes = usage.ri_phys_footprint;
        sample->lifetime_max_physical_footprint_bytes =
            usage.ri_lifetime_max_phys_footprint;
        sample->billed_energy = usage.ri_billed_energy;

        struct proc_taskinfo task_info;
        memset(&task_info, 0, sizeof(task_info));
        int task_info_size = proc_pidinfo(
            pid,
            PROC_PIDTASKINFO,
            0,
            &task_info,
            (int)sizeof(task_info)
        );
        if (task_info_size == (int)sizeof(task_info)) {
            sample->faults = hm_uint32_counter(task_info.pti_faults);
            sample->copy_on_write_faults =
                hm_uint32_counter(task_info.pti_cow_faults);
            sample->mach_system_calls =
                hm_uint32_counter(task_info.pti_syscalls_mach);
            sample->unix_system_calls =
                hm_uint32_counter(task_info.pti_syscalls_unix);
            sample->context_switches = hm_uint32_counter(task_info.pti_csw);
            sample->thread_count =
                task_info.pti_threadnum > 0 ? task_info.pti_threadnum : 0;
            sample->running_thread_count =
                task_info.pti_numrunning > 0 ? task_info.pti_numrunning : 0;
        }

        hm_read_process_metadata(
            pid,
            &sample->parent_pid,
            &sample->uid,
            sample->name,
            (uint32_t)sizeof(sample->name),
            sample->executable_path,
            (uint32_t)sizeof(sample->executable_path)
        );
        if (sample->name[0] == '\0') {
            snprintf(sample->name, sizeof(sample->name), "pid-%d", pid);
        }

        ++written;
    }

    if (written > 0 && attribution_process_limit > 0 && attribution_region_budget > 0) {
        HMProcessAttributionCandidate *candidates =
            (HMProcessAttributionCandidate *)calloc(
                (size_t)written,
                sizeof(HMProcessAttributionCandidate)
            );
        if (candidates != NULL) {
            for (int index = 0; index < written; ++index) {
                candidates[index].index = index;
                candidates[index].physical_footprint_bytes =
                    output[index].physical_footprint_bytes;
            }
            qsort(
                candidates,
                (size_t)written,
                sizeof(HMProcessAttributionCandidate),
                hm_compare_process_candidates
            );

            /*
             * Spend most budget on largest-footprint candidates, but reserve a bounded tail share
             * so small processes are still measured. Charge actual regions and skip shares too
             * small to finish a useful walk rather than recording partial sums as measurements.
             */
            int attempts = attribution_process_limit < written
                ? attribution_process_limit
                : written;
            int tail_reserve =
                attribution_region_budget / HM_ATTRIBUTION_TAIL_BUDGET_DIVISOR;
            if (attempts < tail_reserve / HM_ATTRIBUTION_TAIL_REGION_SHARE) {
                tail_reserve = attempts * HM_ATTRIBUTION_TAIL_REGION_SHARE;
            }
            int remaining_budget = attribution_region_budget;
            int head_budget = remaining_budget - tail_reserve;
            int candidate_index = 0;
            for (;
                 candidate_index < attempts &&
                 head_budget >= HM_ATTRIBUTION_MIN_REGION_SHARE;
                 ++candidate_index) {
                int region_limit = head_budget < HM_ATTRIBUTION_REGION_LIMIT
                    ? head_budget
                    : HM_ATTRIBUTION_REGION_LIMIT;
                int consumed = hm_attribute_candidate(
                    &output[candidates[candidate_index].index],
                    region_limit
                );
                head_budget -= consumed;
                remaining_budget -= consumed;
            }
            for (;
                 candidate_index < attempts && remaining_budget > 0;
                 ++candidate_index) {
                int remaining_candidates = attempts - candidate_index;
                int fair_share = remaining_budget / remaining_candidates;
                int region_limit = fair_share < HM_ATTRIBUTION_REGION_LIMIT
                    ? fair_share
                    : HM_ATTRIBUTION_REGION_LIMIT;
                if (region_limit < HM_ATTRIBUTION_MIN_REGION_SHARE) {
                    if (remaining_budget < HM_ATTRIBUTION_MIN_REGION_SHARE) {
                        break;
                    }
                    region_limit = HM_ATTRIBUTION_MIN_REGION_SHARE;
                }
                remaining_budget -= hm_attribute_candidate(
                    &output[candidates[candidate_index].index],
                    region_limit
                );
            }
            free(candidates);
        }
    }

    free(pids);
    if (inaccessible_processes != NULL) {
        *inaccessible_processes = inaccessible;
    }
    if (written_issues != NULL) {
        *written_issues = issue_count;
    }
    return written;
}

static inline int hm_read_swap(HMSwapSample *output) {
    if (output == NULL) {
        errno = EINVAL;
        return -1;
    }

    struct xsw_usage usage;
    size_t size = sizeof(usage);
    memset(&usage, 0, sizeof(usage));
    if (sysctlbyname("vm.swapusage", &usage, &size, NULL, 0) != 0) {
        return -1;
    }

    output->total_bytes = usage.xsu_total;
    output->available_bytes = usage.xsu_avail;
    output->used_bytes = usage.xsu_used;
    output->encrypted = usage.xsu_encrypted ? 1 : 0;
    return 0;
}

static inline int hm_read_physical_memory(uint64_t *output) {
    if (output == NULL) {
        errno = EINVAL;
        return -1;
    }

    size_t size = sizeof(*output);
    return sysctlbyname("hw.memsize", output, &size, NULL, 0);
}

static inline int hm_read_processor(HMProcessorSample *output) {
    if (output == NULL) {
        errno = EINVAL;
        return -1;
    }
    memset(output, 0, sizeof(*output));

    mach_port_t host = mach_host_self();
    host_cpu_load_info_data_t information;
    mach_msg_type_number_t count = HOST_CPU_LOAD_INFO_COUNT;
    kern_return_t result = host_statistics(
        host,
        HOST_CPU_LOAD_INFO,
        (host_info_t)&information,
        &count
    );
    mach_port_deallocate(mach_task_self(), host);
    if (result != KERN_SUCCESS) {
        errno = EIO;
        return -1;
    }

    output->user_ticks = information.cpu_ticks[CPU_STATE_USER];
    output->system_ticks = information.cpu_ticks[CPU_STATE_SYSTEM];
    output->idle_ticks = information.cpu_ticks[CPU_STATE_IDLE];
    output->nice_ticks = information.cpu_ticks[CPU_STATE_NICE];
    return 0;
}

static inline int hm_read_load_averages(HMLoadAverageSample *output) {
    if (output == NULL) {
        errno = EINVAL;
        return -1;
    }
    double values[3] = {0.0, 0.0, 0.0};
    if (getloadavg(values, 3) != 3) {
        return -1;
    }
    output->one_minute = values[0];
    output->five_minutes = values[1];
    output->fifteen_minutes = values[2];
    return 0;
}

static inline int hm_read_virtual_memory(HMVirtualMemorySample *output) {
    if (output == NULL) {
        errno = EINVAL;
        return -1;
    }
    memset(output, 0, sizeof(*output));

    mach_port_t host = mach_host_self();
    vm_size_t page_size = 0;
    if (host_page_size(host, &page_size) != KERN_SUCCESS) {
        mach_port_deallocate(mach_task_self(), host);
        errno = EIO;
        return -1;
    }

    vm_statistics64_data_t information;
    memset(&information, 0, sizeof(information));
    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
    kern_return_t result = host_statistics64(
        host,
        HOST_VM_INFO64,
        (host_info64_t)&information,
        &count
    );
    mach_port_deallocate(mach_task_self(), host);
    if (result != KERN_SUCCESS) {
        errno = EIO;
        return -1;
    }

    output->page_size_bytes = (uint64_t)page_size;
    output->free_bytes = hm_saturating_multiply_u64(
        information.free_count,
        page_size
    );
    output->active_bytes = hm_saturating_multiply_u64(
        information.active_count,
        page_size
    );
    output->inactive_bytes = hm_saturating_multiply_u64(
        information.inactive_count,
        page_size
    );
    output->wired_bytes = hm_saturating_multiply_u64(
        information.wire_count,
        page_size
    );
    output->purgeable_bytes = hm_saturating_multiply_u64(
        information.purgeable_count,
        page_size
    );
    output->compressed_bytes = hm_saturating_multiply_u64(
        information.compressor_page_count,
        page_size
    );
    output->uncompressed_bytes_in_compressor = hm_saturating_multiply_u64(
        information.total_uncompressed_pages_in_compressor,
        page_size
    );
    output->swap_backed_uncompressed_bytes = hm_saturating_multiply_u64(
        information.swapped_count,
        page_size
    );
    output->pageins = information.pageins;
    output->pageouts = information.pageouts;
    output->faults = information.faults;
    output->copy_on_write_faults = information.cow_faults;
    output->compressions = information.compressions;
    output->decompressions = information.decompressions;
    output->swapins = information.swapins;
    output->swapouts = information.swapouts;
    return 0;
}

static inline int hm_cf_number_to_int(CFTypeRef value, int *output) {
    if (value == NULL || output == NULL || CFGetTypeID(value) != CFNumberGetTypeID()) {
        return 0;
    }
    return CFNumberGetValue((CFNumberRef)value, kCFNumberIntType, output) ? 1 : 0;
}

static inline int hm_cf_number_to_u64(CFTypeRef value, uint64_t *output) {
    if (value == NULL || output == NULL || CFGetTypeID(value) != CFNumberGetTypeID()) {
        return 0;
    }
    int64_t signed_value = 0;
    if (!CFNumberGetValue(
            (CFNumberRef)value,
            kCFNumberSInt64Type,
            &signed_value
        ) ||
        signed_value < 0) {
        return 0;
    }
    *output = (uint64_t)signed_value;
    return 1;
}

static inline int hm_cf_boolean_value(CFTypeRef value, int fallback) {
    if (value == NULL || CFGetTypeID(value) != CFBooleanGetTypeID()) {
        return fallback;
    }
    return CFBooleanGetValue((CFBooleanRef)value) ? 1 : 0;
}

static inline int hm_storage_driver_is_internal(io_registry_entry_t driver) {
    io_iterator_t children = IO_OBJECT_NULL;
    if (IORegistryEntryGetChildIterator(
            driver,
            kIOServicePlane,
            &children
        ) != KERN_SUCCESS) {
        return 0;
    }

    int matched = 0;
    io_registry_entry_t child;
    while ((child = IOIteratorNext(children)) != IO_OBJECT_NULL) {
        if (IOObjectConformsTo(child, kIOMediaClass)) {
            CFTypeRef whole = IORegistryEntryCreateCFProperty(
                child,
                CFSTR(kIOMediaWholeKey),
                kCFAllocatorDefault,
                0
            );
            CFTypeRef removable = IORegistryEntryCreateCFProperty(
                child,
                CFSTR(kIOMediaRemovableKey),
                kCFAllocatorDefault,
                0
            );
            CFTypeRef ejectable = IORegistryEntryCreateCFProperty(
                child,
                CFSTR(kIOMediaEjectableKey),
                kCFAllocatorDefault,
                0
            );
            matched =
                hm_cf_boolean_value(whole, 0) &&
                !hm_cf_boolean_value(removable, 1) &&
                !hm_cf_boolean_value(ejectable, 1);
            if (whole != NULL) {
                CFRelease(whole);
            }
            if (removable != NULL) {
                CFRelease(removable);
            }
            if (ejectable != NULL) {
                CFRelease(ejectable);
            }
        }
        IOObjectRelease(child);
        if (matched) {
            break;
        }
    }
    IOObjectRelease(children);
    return matched;
}

static inline void hm_add_storage_statistic(
    CFDictionaryRef statistics,
    CFStringRef key,
    uint64_t *total
) {
    uint64_t value = 0;
    if (statistics != NULL &&
        total != NULL &&
        hm_cf_number_to_u64(CFDictionaryGetValue(statistics, key), &value)) {
        *total = hm_saturating_add_u64(*total, value);
    }
}

static inline int hm_read_storage(HMStorageSample *output) {
    if (output == NULL) {
        errno = EINVAL;
        return -1;
    }
    memset(output, 0, sizeof(*output));

    struct statfs filesystem;
    if (statfs("/", &filesystem) == 0) {
        output->root_filesystem_total_bytes = hm_saturating_multiply_u64(
            (uint64_t)filesystem.f_blocks,
            (uint64_t)filesystem.f_bsize
        );
        output->root_filesystem_available_bytes = hm_saturating_multiply_u64(
            (uint64_t)filesystem.f_bavail,
            (uint64_t)filesystem.f_bsize
        );
    }

    CFMutableDictionaryRef matching = IOServiceMatching(
        kIOBlockStorageDriverClass
    );
    if (matching == NULL) {
        errno = ENOMEM;
        return -1;
    }

    io_iterator_t iterator = IO_OBJECT_NULL;
    kern_return_t matching_result = IOServiceGetMatchingServices(
        kIOMainPortDefault,
        matching,
        &iterator
    );
    if (matching_result != KERN_SUCCESS) {
        errno = EIO;
        return -1;
    }

    io_registry_entry_t driver;
    while ((driver = IOIteratorNext(iterator)) != IO_OBJECT_NULL) {
        if (hm_storage_driver_is_internal(driver)) {
            CFTypeRef value = IORegistryEntryCreateCFProperty(
                driver,
                CFSTR(kIOBlockStorageDriverStatisticsKey),
                kCFAllocatorDefault,
                0
            );
            if (value != NULL &&
                CFGetTypeID(value) == CFDictionaryGetTypeID()) {
                CFDictionaryRef statistics = (CFDictionaryRef)value;
                hm_add_storage_statistic(
                    statistics,
                    CFSTR(kIOBlockStorageDriverStatisticsBytesReadKey),
                    &output->bytes_read
                );
                hm_add_storage_statistic(
                    statistics,
                    CFSTR(kIOBlockStorageDriverStatisticsBytesWrittenKey),
                    &output->bytes_written
                );
                hm_add_storage_statistic(
                    statistics,
                    CFSTR(kIOBlockStorageDriverStatisticsReadsKey),
                    &output->read_operations
                );
                hm_add_storage_statistic(
                    statistics,
                    CFSTR(kIOBlockStorageDriverStatisticsWritesKey),
                    &output->write_operations
                );
                hm_add_storage_statistic(
                    statistics,
                    CFSTR(kIOBlockStorageDriverStatisticsTotalReadTimeKey),
                    &output->read_time_ns
                );
                hm_add_storage_statistic(
                    statistics,
                    CFSTR(kIOBlockStorageDriverStatisticsTotalWriteTimeKey),
                    &output->write_time_ns
                );
                ++output->device_count;
            }
            if (value != NULL) {
                CFRelease(value);
            }
        }
        IOObjectRelease(driver);
    }
    IOObjectRelease(iterator);

    output->available = output->device_count > 0 ? 1 : 0;
    return 0;
}

static inline int hm_read_battery(HMBatterySample *output) {
    if (output == NULL) {
        errno = EINVAL;
        return -1;
    }
    memset(output, 0, sizeof(*output));
    output->percentage = -1;
    output->minutes_remaining = -1;

    CFTypeRef snapshot = IOPSCopyPowerSourcesInfo();
    if (snapshot == NULL) {
        return -1;
    }

    CFStringRef source_type = IOPSGetProvidingPowerSourceType(snapshot);
    output->on_battery = source_type != NULL &&
        CFStringCompare(source_type, CFSTR(kIOPMBatteryPowerKey), 0) == kCFCompareEqualTo;

    CFArrayRef sources = IOPSCopyPowerSourcesList(snapshot);
    if (sources != NULL) {
        CFIndex count = CFArrayGetCount(sources);
        for (CFIndex index = 0; index < count; ++index) {
            CFTypeRef source = CFArrayGetValueAtIndex(sources, index);
            CFDictionaryRef description = IOPSGetPowerSourceDescription(snapshot, source);
            if (description == NULL) {
                continue;
            }

            CFTypeRef type = CFDictionaryGetValue(description, CFSTR(kIOPSTypeKey));
            if (type == NULL ||
                CFGetTypeID(type) != CFStringGetTypeID() ||
                CFStringCompare(
                    (CFStringRef)type,
                    CFSTR(kIOPSInternalBatteryType),
                    0
                ) != kCFCompareEqualTo) {
                continue;
            }

            output->available = 1;
            int current = 0;
            int maximum = 0;
            hm_cf_number_to_int(
                CFDictionaryGetValue(description, CFSTR(kIOPSCurrentCapacityKey)),
                &current
            );
            hm_cf_number_to_int(
                CFDictionaryGetValue(description, CFSTR(kIOPSMaxCapacityKey)),
                &maximum
            );
            if (maximum > 0) {
                output->percentage = (current * 100) / maximum;
            }

            CFTypeRef charging = CFDictionaryGetValue(
                description,
                CFSTR(kIOPSIsChargingKey)
            );
            output->charging = charging == kCFBooleanTrue ? 1 : 0;
            break;
        }
        CFRelease(sources);
    }

    CFTimeInterval seconds_remaining = IOPSGetTimeRemainingEstimate();
    if (seconds_remaining >= 0.0) {
        output->minutes_remaining = (int32_t)(seconds_remaining / 60.0);
    }

    CFRelease(snapshot);
    return 0;
}

#ifdef __cplusplus
}
#endif

#endif
